# GEMINI_API_KEY: Reserved by runtime environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ONET_API_KEY: Optional server-side O*NET Web Services v2 API key (from services.onetcenter.org).
# Never expose this key to the browser. When unset, ZAHRTI runs in documented local verification mode.
ONET_API_KEY=""
